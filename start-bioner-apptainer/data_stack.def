Bootstrap: docker
From: ubuntu:20.04

%files
    requirements.txt /tmp/requirements.txt

%post
    apt-get update
    apt-get install -y \
        python3 \
        python3-pip \
        python3-dev \
        build-essential

    python3 -m pip install --upgrade pip
    python3 -m pip install --no-cache-dir -r /tmp/requirements.txt

%environment
    export PATH=/usr/local/bin:$PATH

%runscript
    exec python3 "$@"
